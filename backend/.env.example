# Smart Hotel Backend — Environment Variable Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to Git.

PORT=5000
JWT_SECRET=replace_with_a_strong_secret_string

# MongoDB Atlas connection string
DB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smart_hotel?retryWrites=true&w=majority

# ── Amazon S3 Profile Photo Upload ─────────────────────────────────────────
# Get these from AWS Learner Lab → "AWS Details" button.
# Session tokens expire when the lab timer ends — re-paste fresh values each session.
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-smart-hotel-profiles-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_aws_session_token
